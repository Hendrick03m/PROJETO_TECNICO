#include <stdio.h>

int main() {
    int num, resultado;

    printf("Digite um número para ver a sua tabuada: ");
    scanf("%d", &num);

    printf("\n--- Tabuada de %d ---\n", num);
    
    for (int i = 1; i <= 10; i++) {
        resultado = num * i;
        printf("%d x %d = %d\n", num, i, resultado);
    }

    return 0;
}
